@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="tr">
@await Component.InvokeAsync("_HotelMainPageHead")
<body class="bg-surface font-body-default text-on-surface antialiased selection:bg-secondary-fixed selection:text-on-secondary-fixed">

    @await Component.InvokeAsync("_HotelMainPageHeader")

    <main class="w-full pt-20 bg-surface min-h-[calc(100vh-20rem)]">
        <div class="flex flex-col w-full">
            @await Component.InvokeAsync("_HotelMainPageHeroSearch")
            @await Component.InvokeAsync("_HotelMainPageCuratedDestinations")
            @await Component.InvokeAsync("_HotelMainPageAccommodationThemes")
            @await Component.InvokeAsync("_HotelMainPageEditorChoices")
            @await Component.InvokeAsync("_HotelMainPageWhyStayFinder")
            @await Component.InvokeAsync("_HotelMainPageStatsSplit")
        </div>
        <script>
                    function toggleDropdown(id) {
                        const el = document.getElementById(id);
                        if (el) {
                            el.classList.toggle('hidden');
                        }
                    }

                    function setDestination(name) {
                        const label = document.getElementById('input[name="city_name"]');
                        if (label) {
                            label.textContent = name;
                        }
                        const pop = document.getElementById('location-popover');
                        if (pop) {
                            pop.classList.add('hidden');
                        }
                    }

                    // Close popovers on outer click
                    document.addEventListener('click', function(e) {
                        const locPopover = document.getElementById('location-popover');
                        const guestPopover = document.getElementById('guests-popover');
                        if (locPopover && !locPopover.contains(e.target) && !e.target.closest('[onclick*="location-popover"]')) {
                            locPopover.classList.add('hidden');
                        }
                        if (guestPopover && !guestPopover.contains(e.target) && !e.target.closest('[onclick*="guests-popover"]')) {
                            guestPopover.classList.add('hidden');
                        }
                    });

                    function changeCount(id, delta) {
                        const input = document.getElementById(id);
                        const newVal = Math.max(parseInt(input.min), Math.min(parseInt(input.max), parseInt(input.value) + delta));
                        input.value = newVal;
                        updateGuestsSummary();
                    }

                    function updateGuestsSummary() {
                        const adults = document.getElementById('adults').value;
                        const children = document.getElementById('children').value;
                        const rooms = document.getElementById('room_qty').value;
                        document.getElementById('guests-summary').textContent = `${adults} Yetişkin ${children} Çocuk - ${rooms} Oda`;
                        document.getElementById('children_age').value = children > 0 ? '0' : '';
                        const ages = Array.from({ length: parseInt(children) }, () => '0').join(',');
                        document.getElementById('children_age').value = ages;

                    }

        </script>
    </main>
    @await Component.InvokeAsync("_HotelMainPageFooter")
</body>
</html>