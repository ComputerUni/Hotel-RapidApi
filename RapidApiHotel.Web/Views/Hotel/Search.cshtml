@model HotelListViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
@await Component.InvokeAsync("_HotelSearchHead")
<body class="bg-surface font-body-default text-on-surface antialiased selection:bg-secondary-fixed selection:text-on-secondary-fixed">
    @await Component.InvokeAsync("_HotelSearchHeader")
    <main class="w-full pt-20 bg-surface min-h-[calc(100vh-20rem)]">
        <div class="flex flex-col w-full">
            @await Component.InvokeAsync("_HotelSearchFilters")
            <main class="w-full py-space-xl">
                <div class="max-w-[1320px] mx-auto px-margin md:px-margin-tablet lg:px-margin-desktop">
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-desktop items-start">
                        @await Component.InvokeAsync("_HotelSearchLeftFilterPanel")
                        @await Component.InvokeAsync("_HotelSearchMainResults", new { data = Model })
                    </div>
                </div>
            </main>
        </div>
        <script>
                    (function() {
                        const mapBtn = document.getElementById('mapToggleBtn');
                        const mapDrawer = document.getElementById('interactiveMapDrawer');
                        const closeMap = document.getElementById('closeMapDrawer');

                        if (mapBtn && mapDrawer) {
                            mapBtn.addEventListener('click', function() {
                                const isHidden = mapDrawer.classList.contains('hidden');
                                if (isHidden) {
                                    mapDrawer.classList.remove('hidden');
                                    mapBtn.classList.add('bg-terracotta', 'text-pure-white');
                                    mapBtn.classList.remove('bg-sand-surface', 'text-slate-ink');
                                } else {
                                    mapDrawer.classList.add('hidden');
                                    mapBtn.classList.remove('bg-terracotta', 'text-pure-white');
                                    mapBtn.classList.add('bg-sand-surface', 'text-slate-ink');
                                }
                            });
                        }

                        if (closeMap && mapDrawer && mapBtn) {
                            closeMap.addEventListener('click', function() {
                                mapDrawer.classList.add('hidden');
                                mapBtn.classList.remove('bg-terracotta', 'text-pure-white');
                                mapBtn.classList.add('bg-sand-surface', 'text-slate-ink');
                            });
                        }
                    })();

                    function applyFilters() {
                        const minPrice = parseFloat(document.getElementById('filterMinPrice')?.value) || 0;
                        const maxPrice = parseFloat(document.getElementById('filterMaxPrice')?.value) || Infinity;

                        const selectedStars = Array.from(document.querySelectorAll('.star-filter:checked')).map(cb => parseInt(cb.value));
                        const selectedScores = Array.from(document.querySelectorAll('.score-filter:checked')).map(cb => parseFloat(cb.value));
                        const minScore = selectedScores.length > 0 ? Math.min(...selectedScores) : 0;

                        const reqBreakfast = document.getElementById('filterBreakfast')?.checked || false;
                        const reqFreeCancel = document.getElementById('filterFreeCancel')?.checked || false;

                        const cards = document.querySelectorAll('.hotel-card');
                        let visibleCount = 0;

                        cards.forEach(card => {
                            const price = parseFloat(card.dataset.price) || 0;
                            const stars = parseInt(card.dataset.stars) || 0;
                            const score = parseFloat(card.dataset.score) || 0;
                            const hasBreakfast = card.dataset.breakfast == "true";
                            const hasFreeCancel = card.dataset.freecancel == "true";

                            let matches = true;
                            if(price < minPrice || price > maxPrice) matches = false;
                            if(selectedStars.length > 0 && !selectedStars.includes(stars)) matches = false;
                            if(score < minScore) matches = false;
                            if(reqBreakfast && !hasBreakfast) matches = false;
                            if(reqFreeCancel && !hasFreeCancel) matches = false;

                            if(matches) {
                                card.style.display = "flex";
                                visibleCount++;
                            } else {
                                card.style.display = "none";
                            }
                            
                        });
                    }

                    function resetFilters() {
                        if (document.getElementById('filterMinPrice')) document.getElementById('filterMinPrice').value = '';
                        if (document.getElementById('filterMaxPrice')) document.getElementById('filterMaxPrice').value = '';

                        document.querySelectorAll('.star-filter, .score-filter').forEach(cb => cb.checked = false);
                        if (document.getElementById('filterBreakfast')) document.getElementById('filterBreakfast').checked = false;
                        if (document.getElementById('filterFreeCancel')) document.getElementById('filterFreeCancel').checked = false;

                        applyFilters();
                    }

                function sortCards() {
                    const sortType = document.getElementById('sortHotels')?.value;
                    const firstCard = document.querySelector('.hotel-card');
                    if (!firstCard) return;

                    const container = firstCard.parentElement;
                    const cards = Array.from(container.querySelectorAll('.hotel-card'));

                    if (sortType === 'price_asc') {
                        cards.sort((a, b) => (parseFloat(a.dataset.price) || 0) - (parseFloat(b.dataset.price) || 0));
                    } else if (sortType === 'price_desc') {
                        cards.sort((a, b) => (parseFloat(b.dataset.price) || 0) - (parseFloat(a.dataset.price) || 0));
                    } else if (sortType === 'rating_desc' || sortType === 'score_desc') {
                        cards.sort((a, b) => (parseFloat(b.dataset.score) || 0) - (parseFloat(a.dataset.score) || 0));
                    }      

                    cards.forEach(card => container.appendChild(card));

                    const pagination = container.querySelector('nav')?.closest('.pt-space-xl') || container.querySelector('.pagination-wrapper');
                    if (pagination) {
                        container.appendChild(pagination);
                    }
                }
        </script>
    </main>
    @await Component.InvokeAsync("_HotelSearchFooter")
</body>
</html>