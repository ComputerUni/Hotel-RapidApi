@model HotelDetailViewModel

@{
    var d = Model.data;
    var raw = d.rawData;

    var hotelDesc = Model?.hotelDescriptionAndInfo?.data?.FirstOrDefault(x => x.languagecode == "tr")?.description
                 ?? Model?.hotelDescriptionAndInfo?.data?.FirstOrDefault()?.description;

    var rawCode = Model?.hotelReviewTips?.data?.result?.FirstOrDefault()?.author?.countrycode;
    var countryCode = rawCode?.Trim().ToLowerInvariant();

    var language = countryCode switch
    {
        "tr" => "Türkçe",
        "az" => "Azerice",
        "kk" or "kz" => "Kazakça",
        "uz" => "Özbekçe",
        "tm" => "Türkmence",
        "ky" or "kg" => "Kırgızca",

        "en" or "gb" or "us" or "en-gb" or "en-us" or "au" or "ca" or "nz" or "ie" => "İngilizce",

        "de" or "at" or "ch" => "Almanca",
        "fr" or "be" => "Fransızca",
        "it" => "İtalyanca",
        "es" => "İspanyolca",
        "pt" or "br" => "Portekizce",
        "nl" => "Felemenkçe",

        "ru" => "Rusça",
        "ua" or "uk" => "Ukraynaca",
        "pl" => "Lehçe (Polonca)",
        "cz" or "cs" => "Çekçe",
        "sk" => "Slovakça",
        "bg" => "Bulgarca",
        "ro" => "Romence",
        "rs" or "sr" => "Sırpça",
        "hr" => "Hırvatça",
        "ba" or "bs" => "Boşnakça",

        "se" or "sv" => "İsveççe",
        "no" => "Norveççe",
        "dk" or "da" => "Danca",
        "fi" => "Fince",
        "ee" or "et" => "Estonca",
        "lv" => "Letonca",
        "lt" => "Litvanca",

        "gr" or "el" => "Yunanca",
        "al" or "sq" => "Arnavutça",
        "mk" => "Makedonca",
        "hu" => "Macarca",

        "ar" or "sa" or "ae" or "eg" or "qa" or "kw" => "Arapça",
        "ir" or "fa" => "Farsça",
        "il" or "he" => "İbranice",
        "ge" or "ka" => "Gürcüce",
        "am" or "hy" => "Ermenice",

        "cn" or "zh" => "Çince",
        "jp" or "ja" => "Japonca",
        "kr" or "ko" => "Korece",
        "in" or "hi" => "Hintçe",
        "id" => "Endonezce",
        "my" or "ms" => "Malayca",
        "th" => "Tayca",
        "vn" or "vi" => "Vietnamca",

        null or "" => "Belirtilmedi",
        _ => countryCode.ToUpperInvariant()
    };
}



<section class="scroll-mt-32" id="genel-bakis">
    <div class="flex items-center gap-space-xs mb-space-xs">
        <span class="w-8 h-[2px] bg-terracotta"></span>
        <span class="font-label-caps text-label-caps text-terracotta uppercase tracking-wider">Genel Bilgiler</span>
    </div>
    <h2 class="font-headline-lg text-headline-lg text-slate-ink mb-space-md">@d.hotel_name Hakkında</h2>
    <div class="font-body-default text-body-default text-muted-stone space-y-space-md mb-space-lg leading-relaxed">
        <p>
            <strong class="text-slate-ink">@d.hotel_name</strong>, @d.city, @d.country_trans konumunda yer alan bir <strong>@d.accommodation_type_name</strong>.
            Şehir merkezine <strong>@d.distance_to_cc.ToString("0.0") km</strong> uzaklıktadır.
        </p>
        <p>
            Giriş saati: <strong>@raw?.checkin?.fromTime — @raw?.checkin?.untilTime</strong> ·
            Çıkış saati: <strong>@raw?.checkout?.fromTime — @raw?.checkout?.untilTime</strong>
        </p>
        @if (d.hotel_include_breakfast == 1)
        {
            <p>✓ Kahvaltı fiyata dahildir.</p>
        }
        @if (d.is_family_friendly == 1)
        {
            <p>✓ Aile dostu tesis.</p>
        }
        @if (d.spoken_languages?.Any() == true)
        {
            <p>Konuşulan diller: <strong>@string.Join(", ", language)</strong></p>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(hotelDesc))
    {
        <div class="font-body-default text-body-default text-slate-ink/80 space-y-space-sm mb-space-lg leading-relaxed whitespace-pre-line">
            @Html.Raw(hotelDesc)
        </div>
    }

    @if (d.top_ufi_benefits?.Any() == true)
    {
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-space-sm">
            @foreach (var benefit in d.top_ufi_benefits.Take(3))
            {

                var iconName = benefit.icon?.ToLowerInvariant() switch
                {
                    "fitness" => "fitness_center",
                    "nosmoking" => "smoke_free",
                    "clean" => "room_service",
                    "disabled" => "accessible",
                    "food_and_drink" => "restaurant",
                    "family" => "family_restroom",
                    "shuttle" => "airport_shuttle",
                    _ => benefit.icon ?? "check_circle"
                };

                <div class="p-space-md rounded-xl bg-pure-white shadow-sm flex items-start gap-space-sm">
                    <span class="material-symbols-outlined text-terracotta text-[24px]">@iconName</span>
                    <div>
                        <h4 class="font-label-lg text-label-lg text-slate-ink">@benefit.translated_name</h4>
                    </div>
                </div>
            }
        </div>
    }
</section>