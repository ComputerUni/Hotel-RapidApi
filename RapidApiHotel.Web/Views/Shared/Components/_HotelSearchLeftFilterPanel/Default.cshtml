                    <label class="block font-label-caps text-[10px] text-muted-stone uppercase">En Az</label>
                    <input id="filterMinPrice" oninput="applyFilters()" type="number" placeholder="0"
                           class="w-full bg-transparent font-headline-sm text-slate-ink text-sm font-bold focus:outline-none" />
                </div>
                <div class="bg-sand-canvas rounded-lg p-2">
                    <label class="block font-label-caps text-[10px] text-muted-stone uppercase">En Çok</label>
