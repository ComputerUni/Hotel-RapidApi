                <span class="material-symbols-outlined text-slate-ink text-[20px]">tune</span>
                <h2 class="font-headline-sm text-headline-sm text-slate-ink font-semibold">Filtreler</h2>
            </div>
            <button onclick="resetFilters()" class="font-label-caps text-label-caps text-terracotta hover:underline uppercase tracking-wider text-xs font-bold" type="button">
