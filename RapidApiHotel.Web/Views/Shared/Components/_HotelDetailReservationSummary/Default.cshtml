@model HotelDetailViewModel

@{
    var d = Model.data;
    var raw = d.rawData;
    var scoreBreakdown = Model.hotelReviewScores?.data?.FirstOrDefault()?.score_breakdown?.FirstOrDefault();
    var questions = scoreBreakdown?.question?.Where(x => x.score != null).Take(4).ToList() ?? new();

    var countryCode = Model.hotelReviewTips.data.result.FirstOrDefault().author.countrycode.ToLowerInvariant();

    var countryName = countryCode switch
    {
        "tr" => "Türkiye",
        "gb" => "Birleşik Krallık",
        "de" => "Almanya",
        "us" => "ABD",
        "ru" => "Rusya",
        "az" => "Azerbaycan",
        "ge" => "Gürcistan",
        _ => countryCode.ToUpper() ?? ""
    };

    var price = d.product_price_breakdown;
    var rooms = Model.roomList?.available ?? new List<HotelRoomListWithAvailabilityViewModel.Available>();
}


<aside class="lg:col-span-4 lg:sticky lg:top-28">
    <div class="bg-pure-white rounded-2xl p-space-lg shadow-xl ring-1 ring-sand-border relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-terracotta via-amber-gold to-slate-ink"></div>
        <div class="flex items-center justify-between pb-space-sm mb-space-md">
            <div>
                <span class="font-label-caps text-label-caps text-terracotta uppercase tracking-wider block">Rezervasyon Özeti</span>
                <h3 class="font-headline-sm text-headline-sm text-slate-ink font-bold">@d.hotel_name</h3>
            </div>
            @if (d.hotel_include_breakfast == 1)
            {
                <div class="text-right">
                    <span class="font-label-caps text-label-caps text-soft-success font-semibold">Kahvaltı Dahil</span>
                </div>
            }
        </div>
        <div class="p-space-sm bg-sand-canvas rounded-xl mb-space-md space-y-space-xs">
            <div class="flex items-center justify-between text-slate-ink">
                <div class="flex items-center gap-space-2xs">
                    <span class="material-symbols-outlined text-[18px] text-terracotta">calendar_month</span>
                    <span class="font-label-md text-label-md">@d.arrival_date — @d.departure_date</span>
                </div>
            </div>
        </div>
        <div class="space-y-space-xs mb-space-md text-muted-stone font-body-sm text-body-sm">
            <div class="flex justify-between items-center">
                <span>Gecelik</span>
                <span class="text-slate-ink font-medium">@price?.gross_amount_per_night?.amount_rounded @price?.gross_amount_per_night?.currency</span>
            </div>
            @if (price?.included_taxes_and_charges_amount?.value > 0)
            {
                <div class="flex justify-between items-center">
                    <span>Vergi &amp; Harçlar</span>
                    <span class="text-slate-ink font-medium">@price.included_taxes_and_charges_amount.amount_rounded @price.included_taxes_and_charges_amount.currency</span>
                </div>
            }
            <div class="pt-space-xs"></div>
            <div class="flex justify-between items-baseline pt-space-xs">
                <div>
                    <span class="font-label-caps text-label-caps text-slate-ink uppercase tracking-wider block">Toplam Tutar</span>
                    <span class="font-body-sm text-body-sm text-muted-stone text-xs">Tüm vergiler dahildir</span>
                </div>
                <div class="text-right">
                    <div class="font-headline-lg text-headline-lg text-slate-ink font-bold tracking-tight">@price?.gross_amount?.amount_rounded @price?.gross_amount?.currency</div>
                </div>
            </div>
        </div>
        <button class="w-full py-space-md px-space-lg rounded-xl bg-terracotta hover:bg-slate-ink text-pure-white font-label-lg text-label-lg transition-all duration-300 shadow-md flex items-center justify-center gap-space-xs group" type="button">
            <span>Hemen Rezerve Et</span>
            <span class="material-symbols-outlined text-[20px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
        </button>
        <p class="font-body-sm text-body-sm text-muted-stone text-center text-xs mt-space-xs">Şimdi rezervasyon yapın, ödemeyi tesiste gerçekleştirin.</p>
        <div class="mt-space-lg pt-space-md space-y-space-xs">
            <div class="flex items-center gap-space-xs text-slate-ink font-label-md text-label-md">
                <span class="material-symbols-outlined text-soft-success text-[18px]">bolt</span>
                <span>Anında Onay</span>
            </div>
            @if (rooms.Any(r => r.refundable == 1))
            {
                <div class="flex items-center gap-space-xs text-slate-ink font-label-md text-label-md">
                    <span class="material-symbols-outlined text-soft-success text-[18px]">event_available</span>
                    <span>Ücretsiz İptal Seçeneği Mevcut</span>
                </div>
            }
            <div class="flex items-center gap-space-xs text-slate-ink font-label-md text-label-md">
                <span class="material-symbols-outlined text-soft-success text-[18px]">verified_user</span>
                <span>Güvenli Ödeme</span>
            </div>
        </div>
    </div>
</aside>