@model HotelDetailViewModel
@{
    var d = Model.data;
    var raw = d.rawData;

    var photos = raw?.photoUrls?.Select(p => p.Replace("square60", "max1280").Replace("max300", "max1280")).ToArray();
    var totalPhotos = photos.Length;
    var mainPhoto = totalPhotos > 0 ? photos[0] : "";
}


<section class="max-w-[1320px] w-full mx-auto px-margin md:px-margin-tablet lg:px-margin-desktop mb-space-2xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xs rounded-2xl overflow-hidden bg-sand-surface p-space-xs shadow-md">

        <div class="@(totalPhotos > 1 ? "lg:col-span-7" : "lg:col-span-12") relative h-[340px] sm:h-[460px] lg:h-[520px] rounded-xl overflow-hidden group">
            <img class="w-full h-full object-cover transform group-hover:scale-[1.02] transition-transform duration-700 ease-out"
                 alt="@d.hotel_name" src="@mainPhoto" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-ink/70 via-transparent to-transparent opacity-80 pointer-events-none"></div>
            <div class="absolute bottom-space-lg left-space-lg right-space-lg text-pure-white flex items-end justify-between">
                <div>
                    <span class="inline-block px-space-xs py-[2px] rounded-full bg-pure-white/20 backdrop-blur-md font-label-caps text-label-caps uppercase tracking-wider mb-space-2xs text-pure-white">@d.accommodation_type_name</span>
                    <h3 class="font-headline-md text-headline-md text-pure-white drop-shadow-sm">@d.hotel_name — @d.city, @d.country_trans</h3>
                </div>
                <div class="hidden sm:flex items-center gap-space-2xs px-space-sm py-space-xs rounded-full bg-slate-ink/80 backdrop-blur-md text-pure-white font-label-caps text-label-caps">
                    <span class="material-symbols-outlined text-[16px] text-amber-gold">verified</span>
                    <span>@d.city Seçkisi</span>
                </div>
            </div>
        </div>

        @if (totalPhotos > 1)
        {
            <div class="lg:col-span-5 grid grid-cols-2 gap-space-xs h-[340px] sm:h-[460px] lg:h-[520px]">
                @for (int i = 1; i <= 3 && i < totalPhotos; i++)
                {
                    <div class="relative rounded-xl overflow-hidden group h-full">
                        <img class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                             alt="@d.hotel_name @i" src="@photos[i]" />
                    </div>
                }

                @if (totalPhotos > 4)
                {
                    <div class="relative rounded-xl overflow-hidden group h-full cursor-pointer">
                        <img class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                             alt="@d.hotel_name" src="@photos[4]" />
                        <div class="absolute inset-0 bg-slate-ink/60 group-hover:bg-slate-ink/75 transition-colors flex flex-col items-center justify-center text-pure-white">
                            <span class="material-symbols-outlined text-[28px] mb-space-2xs text-amber-gold">photo_library</span>
                            <span class="font-headline-sm text-headline-sm font-semibold">+@(totalPhotos - 4) Fotoğraf</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>