<section class="w-full bg-sand-surface py-space-md">
    <div class="max-w-[1320px] mx-auto px-margin md:px-margin-tablet lg:px-margin-desktop">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm">
            <div>
                <div class="flex items-center gap-space-xs mb-1">
                    <span class="px-space-xs py-0.5 rounded-full bg-slate-ink text-pure-white font-label-caps text-label-caps">ARAMA SONUÇLARI</span>
                    <span class="font-body-sm text-body-sm text-muted-stone">Küratör Onaylı Tesisler</span>
                </div>
                <h1 class="font-headline-xl text-headline-xl text-slate-ink tracking-tight">
                    Öne Çıkan <span class="italic font-normal text-terracotta">Seçkin</span> Konaklama Noktaları
                </h1>
            </div>
            <div class="text-left sm:text-right">
                <span class="font-label-caps text-label-caps text-muted-stone block uppercase tracking-wider">LİSTELEME DURUMU</span>
                <span class="font-label-md text-label-md text-slate-ink font-semibold">Tüm Tesisler Müsaitlik Sırasına Göre</span>
            </div>
        </div>
    </div>
</section>

<section class="w-full bg-pure-white py-space-sm border-b border-sand-border/40 mb-space-lg">
    <div class="max-w-[1320px] mx-auto px-margin md:px-margin-tablet lg:px-margin-desktop flex items-center justify-between">

        <div class="font-body-sm text-body-sm text-muted-stone">
            Sonuçlar listeleniyor
        </div>

        <div class="flex items-center gap-space-sm">
            <div class="relative flex items-center bg-sand-canvas rounded-lg px-space-sm py-1.5">
                <span class="font-label-caps text-label-caps text-muted-stone mr-space-xs hidden md:inline">SIRALA:</span>
                <select id="sortHotels" onchange="sortCards()" aria-label="Sonuç Sıralama" class="bg-transparent font-label-md text-label-md text-slate-ink focus:outline-none cursor-pointer pr-space-md text-xs">
                    <option value="default">Önerilen Sıralama</option>
                    <option value="price_asc">Fiyat: Düşükten Yükseğe</option>
                    <option value="price_desc">Fiyat: Yüksekten Düşüğe</option>
                </select>
            </div>

            <div class="flex items-center bg-sand-canvas rounded-lg p-0.5">
                <button class="p-1.5 rounded-md bg-pure-white text-slate-ink shadow-sm" title="Liste Görünümü" type="button">
                    <span class="material-symbols-outlined text-[18px]">view_agenda</span>
                </button>
                <button class="p-1.5 rounded-md text-muted-stone hover:text-slate-ink transition-colors" title="Kare Görünümü" type="button">
                    <span class="material-symbols-outlined text-[18px]">grid_view</span>
                </button>
            </div>
        </div>

    </div>
</section>